# Environment / secrets
.env
.env.*
!.env.example
*.secret
*.secrets

# Keys / certificates
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore

# Sensitive Pi data
data/
private/
secrets/
backups/
*.db
*.sqlite
*.sqlite3

# Logs
*.log

# Temporary files
*.tmp
*.swp
*~
